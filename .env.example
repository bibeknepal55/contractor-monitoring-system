# ============================================================
# Contractor Monitoring System — Docker Compose Environment
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ============================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# JWT — must be at least 32 characters
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_here

# Seed — initial SuperAdmin account password
SEED_ADMIN_PASSWORD=your_superadmin_password_here
